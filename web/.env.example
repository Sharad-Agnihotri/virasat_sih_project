# Copy to .env and fill in your own key:  cp .env.example .env
#
# Virasat's AI features (Virasat Mitr chat, monument identification,
# translation, neural voice) all run through the Groq proxy in server.js.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# --- Optional overrides (sensible defaults are built in) ---
# PORT=3005
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=leo
# GROQ_VISION_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b
